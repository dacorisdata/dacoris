# Production Environment Configuration
# Copy this file to .env.production and fill in your production values

# Database
DATABASE_URL=postgresql+asyncpg://DB_USER:DB_PASSWORD@db:5432/DB_NAME
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_NAME=dacoris_prod

# Frontend
FRONTEND_URL=https://yourdomain.com

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET_KEY=GENERATE_A_STRONG_RANDOM_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_SESSION_EXPIRE_MINUTES=480

# ORCID Configuration (Production)
ORCID_CLIENT_ID=YOUR_PRODUCTION_ORCID_CLIENT_ID
ORCID_CLIENT_SECRET=YOUR_PRODUCTION_ORCID_CLIENT_SECRET
ORCID_REDIRECT_URI=https://yourdomain.com/api/auth/orcid/callback
ORCID_SANDBOX_MODE=false
ORCID_API_BASE_URL=https://orcid.org

# Admin Account (Auto-created on first run)
ADMIN_NAME=Global Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# File Upload
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50

# Notifications
NOTIFICATION_MODE=email

# Email Configuration (Production SMTP)
SMTP_HOST=smtp.yourmailserver.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=DACORIS <no-reply@yourdomain.com>

# KoboToolbox
KOBO_API_BASE_URL=https://kf.kobotoolbox.org/api/v2

# MinIO Configuration (Production Lakehouse)
MINIO_ENDPOINT=https://your-minio-endpoint.com
MINIO_ACCESS_KEY=YOUR_PRODUCTION_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_PRODUCTION_MINIO_SECRET_KEY
MINIO_BRONZE_BUCKET=dacoris-bronze-prod
MINIO_USE_SSL=true

# Ingest API Key (Generate a strong random key)
INGEST_API_KEY=GENERATE_STRONG_RANDOM_KEY_HERE

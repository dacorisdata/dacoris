FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Note: node_modules will be mounted from host, so we skip npm install here
# This makes the build instant but requires you to run npm install locally first

# Copy the rest of the application
COPY . .

# Expose port
EXPOSE 3000

# Set environment variables
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=development

# Start the development server with hot reload
CMD ["npm", "run", "dev"]

# DACORIS Staging Environment Configuration
# Copy this file to .env.staging and fill in the values

PORT=8000
FRONTEND_URL=https://staging.yourdomain.com

# Database Configuration
DB_USER=postgres
DB_PASSWORD=your-secure-database-password
DB_NAME=dacoris
DATABASE_URL=postgresql+asyncpg://postgres:your-secure-database-password@db:5432/dacoris

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_SESSION_EXPIRE_MINUTES=480

# ORCID Configuration (Sandbox)
ORCID_CLIENT_ID=your-orcid-client-id
ORCID_CLIENT_SECRET=your-orcid-client-secret
ORCID_REDIRECT_URI=https://staging.yourdomain.com/api/auth/orcid/callback
ORCID_SANDBOX_MODE=true
ORCID_API_BASE_URL=https://sandbox.orcid.org

# Admin Configuration
GLOBAL_ADMIN_EMAIL=admin@yourdomain.com

# File Upload Configuration
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50

# Notification Configuration
NOTIFICATION_MODE=email

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL="DACORIS Staging <no-reply@yourdomain.com>"

# External APIs
KOBO_API_BASE_URL=https://kf.kobotoolbox.org/api/v2

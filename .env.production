# Production Environment Configuration
PORT=8000
FRONTEND_URL=https://rims.dacoris.com
DATABASE_URL=postgresql+asyncpg://postgres:${DB_PASSWORD}@db:5432/dacoris

# Security Keys (GENERATE NEW ONES)
JWT_SECRET_KEY=your-strong-jwt-secret-key-here-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_SESSION_EXPIRE_MINUTES=480

# ORCID Configuration (Update with your actual keys)
ORCID_CLIENT_ID=your-orcid-client-id
ORCID_CLIENT_SECRET=your-orcid-client-secret
ORCID_REDIRECT_URI=https://rims.dacoris.com/api/auth/orcid/callback
ORCID_SANDBOX_MODE=false
ORCID_API_BASE_URL=https://orcid.org

# Admin Email
GLOBAL_ADMIN_EMAIL=admin@rims.dacoris.com

# File Upload
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50

# Notification Settings
NOTIFICATION_MODE=email

# Email SMTP (Update with your SMTP settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@rims.dacoris.com
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL="DACORIS <no-reply@rims.dacoris.com>"

# Kobo Integration
KOBO_API_BASE_URL=https://kf.kobotoolbox.org/api/v2

# Database Password (GENERATE A STRONG ONE)
DB_PASSWORD=your-strong-db-password-here-change-this
